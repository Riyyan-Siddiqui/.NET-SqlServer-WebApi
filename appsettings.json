{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MyAppDb;TrustServerCertificate=True;Trusted_Connection=True;Encrypt=False;"
  },
  "JWT": {
    "Key": "YourSecretKeyHere",
    "Issuer": "YourIssuerHere",
    "Audience": "YourAudienceHere",
    "DurationInMinutes": 60
  },
  "AllowedHosts": "*"
}
